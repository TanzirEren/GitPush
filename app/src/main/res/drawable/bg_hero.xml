<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/gpPrimary" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:gravity="end|top" android:width="120dp" android:height="120dp" android:top="14dp" android:right="14dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#44888888" />
        </shape>
    </item>
    <item android:gravity="end|bottom" android:width="64dp" android:height="64dp" android:bottom="18dp" android:right="76dp">
        <shape android:shape="oval">
            <solid android:color="#22888888" />
        </shape>
    </item>
</layer-list>
