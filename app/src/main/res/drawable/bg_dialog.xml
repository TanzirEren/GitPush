<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/gpGlassStrong" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="?attr/gpStrokeB" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270" android:startColor="?attr/gpAuroraA" android:endColor="#00000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
